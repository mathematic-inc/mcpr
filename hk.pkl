amends ".hk/org.pkl"

steps {
  ["go-build"] {
    glob = List("go.mod", "go.sum", "**/*.go")
    check = "go build ./..."
    depends = "go-vet"
    profiles = List("slow")
  }
  ["go-test"] {
    glob = List("go.mod", "go.sum", "**/*.go")
    check = "go test -race ./..."
    depends = "go-build"
    profiles = List("slow")
  }
}
